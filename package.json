{
  "name": "skillscan",
  "version": "0.1.0",
  "private": true,
  "description": "Static, zero-AI security scanner for Claude Code skills, MCP servers, npm packages, VS Code extensions, and GitHub Actions workflows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwellyoung/skillscan.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cli": "node scripts/build-cli.mjs",
    "start": "next start",
    "skillscan": "tsx cli/skillscan.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "eval:malicious": "tsx scripts/eval-malicious-fixtures.ts",
    "eval:local-skills": "tsx scripts/eval-local-skills.ts",
    "lint": "eslint app lib cli test scripts --max-warnings 0",
    "fallow": "npx --yes fallow",
    "fallow:dead-code": "npx --yes fallow dead-code",
    "fallow:dupes": "npx --yes fallow dupes",
    "fallow:health": "npx --yes fallow health",
    "fallow:audit": "npx --yes fallow audit",
    "fallow:fix:dry-run": "npx --yes fallow fix --dry-run",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.563.0",
    "next": "15.5.27",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "0.28.2",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.29",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.34.6"
}
